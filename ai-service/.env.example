# Configuration du service IA

# Port du service IA
AI_SERVICE_PORT=5000

# Mode debug
AI_SERVICE_DEBUG=False

# Configuration de la base de données PostgreSQL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:martin4274@localhost:5432/orientation_db

# SSL pour la connexion à la BD (true/false)
DB_SSL=false

# Afficher les requêtes SQL (true/false)
SQL_ECHO=false

# Configuration du serveur backend
BACKEND_API_URL=http://localhost:3000/api

# Logging
LOG_LEVEL=INFO
